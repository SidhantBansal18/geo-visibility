# Copy to backend/.env and fill in. Any engine with a key is measured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Gemini grounding: google (needs grounding quota) or tavily (free Gemini keys).
GEMINI_GROUNDING=google
TAVILY_API_KEY=

# Run the whole product offline with simulated AI answers (no keys needed).
GEO_MOCK=0

# Models (change as providers release new ones).
CHATGPT_MODEL=gpt-5-mini
CLAUDE_MODEL=claude-opus-5
GEMINI_MODEL=gemini-2.5-flash
PERPLEXITY_MODEL=sonar
UTILITY_MODEL=gpt-5-mini
CLAUDE_UTILITY_MODEL=claude-opus-5

# Measurement
SAMPLES_PER_QUERY=5
ENGINE_CONCURRENCY=4

DATABASE_URL=sqlite:///./geo.db
CORS_ORIGINS=http://localhost:3000
SCHEDULER_ENABLED=1
